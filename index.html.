<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calculadora de Média</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background: #e8efff;
            text-align: center;
            padding: 30px;
        }

        .calculadora {
            background: white;
            max-width: 350px;
            margin: auto;
            padding: 25px;
            border-radius: 15px;
        }

        input {
            width: 80%;
            padding: 10px;
            margin: 8px;
        }

        button {
            background: #2563eb;
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 8px;
            cursor: pointer;
        }

        #resultado {
            font-weight: bold;
            margin-top: 20px;
        }
    </style>
</head>

<body>

    <div class="calculadora">
        <h1>Calculadora de Média</h1>

        <p>Digite suas quatro notas:</p>

        <input type="number" id="nota1" placeholder="Primeira nota" min="0" max="10" step="0.01">

        <input type="number" id="nota2" placeholder="Segunda nota" min="0" max="10" step="0.01">

        <input type="number" id="nota3" placeholder="Terceira nota" min="0" max="10" step="0.01">

        <input type="number" id="nota4" placeholder="Quarta nota" min="0" max="10" step="0.01">

        <button onclick="calcularMedia()">Calcular média</button>

        <p id="resultado"></p>
    </div>

    <script>
        function calcularMedia() {

            let n1 = Number(document.getElementById("nota1").value);
            let n2 = Number(document.getElementById("nota2").value);
            let n3 = Number(document.getElementById("nota3").value);
            let n4 = Number(document.getElementById("nota4").value);

            if (
                document.getElementById("nota1").value === "" ||
                document.getElementById("nota2").value === "" ||
                document.getElementById("nota3").value === "" ||
                document.getElementById("nota4").value === "" ||
                [n1, n2, n3, n4].some(n => n < 0 || n > 10)
            ) {
                document.getElementById("resultado").innerText =
                    "Digite quatro notas válidas entre 0 e 10.";
                return;
            }

            let media = (n1 + n2 + n3 + n4) / 4;

            document.getElementById("resultado").innerText =
                "Sua média é: " + media.toFixed(2);
        }
    </script>

</body>
</html>
